# Backend base URL for the frontend.
# In development you can use the local backend URL directly.
# Example for local backend: VITE_API_BASE_URL=http://localhost:8000
# Example for deployed backend: VITE_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=http://localhost:8000

# Local backend target for Vite dev server proxy if you use /api path in development.
VITE_DEV_API_PROXY_TARGET=http://localhost:8000
